# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=apag_knowledge_base
POSTGRES_USER=postgres
POSTGRES_PASSWORD=apag_secure_password_2026
DATABASE_URL=postgresql://postgres:apag_secure_password_2026@localhost:5432/apag_knowledge_base

# Storage Backend: 'local' (development) or 'minio' (S3 Object Storage)
STORAGE_BACKEND=local

# MinIO Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=apag_admin
MINIO_SECRET_KEY=apag_secure_password_2026
MINIO_SECURE=false

# Authentication (JWT)
# MUST be set to a long random value for ANY deployment reachable by more than one machine.
# src/core/config.py ships an insecure placeholder default so local dev works out of the box;
# because this key signs every access token, anyone who knows it can forge a token for any
# user (including ADMIN). Generate one with:
#     openssl rand -hex 32
JWT_SECRET_KEY=generate-with-openssl-rand-hex-32-do-not-use-this-value

# Application Settings
ENVIRONMENT=development
PROJECT_NAME="A-PAG AI Knowledge Base"

# ---------------------------------------------------------------------------
# Answer generation (Sarvam). Optional: without a key the service still runs,
# /ask returns 503 and the UI falls back to showing passages. That is the
# intended behaviour for a deployment without external inference.
# ---------------------------------------------------------------------------
SARVAM_API_KEY=
# Two models exist and they behave completely differently despite the shared
# name. sarvam-105b is a *reasoning* model: measured against a real 8-passage
# context it spent 6,229 completion tokens and 75 seconds to produce the same
# answer -conversations produced in 1.6s and 251 tokens, and at 4 passages it
# exhausted an 8,192-token budget thinking and returned nothing at all.
SARVAM_MODEL=sarvam-105b-conversations

# ---------------------------------------------------------------------------
# Reranking. Where most of the retrieval quality comes from: measured on 100
# questions, 81% first-result accuracy with it against 76% without, and 95%
# top-five against 90%. It is also the only per-query CPU cost in the request
# path -- about 2.2s on 10 cores, proportionally longer on fewer. Set false if
# a small VM cannot afford it; the cost is those 5 points.
# ---------------------------------------------------------------------------
RERANK_ENABLED=true

# ---------------------------------------------------------------------------
# OCR for scanned PDFs. Three of A-PAG's first 40 documents are photographs of
# pages with no text layer, including a 162-page set of CPCB directions.
#
# OCR_THREADS is not a tuning detail: left at the onnxruntime default these
# pages measured 20.5s each against 3.5s at 8 intra-op threads. 0 means
# min(8, cpu_count), which is the right default -- set it explicitly only to
# hold OCR below the machine's core count so it does not starve everything else.
# ---------------------------------------------------------------------------
OCR_ENABLED=true
OCR_THREADS=0

# ---------------------------------------------------------------------------
# Evaluation only (run_ragas.py). Never read by the running service. The judge
# is deliberately a different provider from the model under test: using Sarvam
# to grade Sarvam measures self-consistency, not truthfulness.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
RAGAS_JUDGE_MODEL=gpt-5-mini
